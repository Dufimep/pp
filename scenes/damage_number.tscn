[gd_scene load_steps=2 format=3 uid="//uid://damage_number"]

[ext_resource type="Script" path="res://scripts/globals.gd" id="1"]

[sub_resource type="Shader" id="Shader_1"]
shader_type = "particles"

uniform float lifetime : hint_range(0.5, 3.0) = 1.0;

void start() {
    VELOCITY = vec3(randf_range(-30.0, 30.0), randf_range(-80.0, -40.0), 0.0);
    COLOR = vec4(1.0, 0.3, 0.2, 1.0);
    SCALE = vec3(1.2);
    CUSTOM = vec4(0.0, float(randi() % 10)); // damage number
}

void process() {
    CUSTOM.x += DELTA;
    VELOCITY.y += 100.0 * DELTA;
    VELOCITY.x *= pow(0.98, DELTA * 60.0);
    COLOR.a = 1.0 - smoothstep(0.5, lifetime, CUSTOM.x);
    
    if (CUSTOM.x >= lifetime) {
        KILL = true;
    }
}

