[gd_scene load_steps=2 format=3 uid="//uid://jump_dust"]

[ext_resource type="Script" path="res://scripts/globals.gd" id="1"]

[sub_resource type="Shader" id="Shader_1"]
shader_type = "particles"
render_mode = "additive"

uniform float lifetime : hint_range(0.1, 1.0) = 0.3;

void start() {
    VELOCITY = vec3(randf_range(-50.0, 50.0), randf_range(-20.0, 20.0), 0.0);
    COLOR = vec4(0.6, 0.5, 0.4, 0.6);
    SCALE = vec3(0.6);
    CUSTOM = vec4(0.0);
}

void process() {
    CUSTOM.x += DELTA;
    VELOCITY.y += 100.0 * DELTA;
    VELOCITY.x *= pow(0.9, DELTA * 60.0);
    COLOR.a = 0.6 * (1.0 - smoothstep(0.0, lifetime, CUSTOM.x));
    SCALE = vec3(lerp(0.6, 1.2, CUSTOM.x / lifetime));
    
    if (CUSTOM.x >= lifetime) {
        KILL = true;
    }
}

