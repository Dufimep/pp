[gd_scene load_steps=2 format=3 uid="//uid://tile_place_effect"]

[ext_resource type="Script" path="res://scripts/globals.gd" id="1"]

[sub_resource type="Shader" id="Shader_1"]
shader_type = "particles"
render_mode = "additive"

uniform float lifetime : hint_range(0.1, 2.0) = 0.4;

void start() {
    VELOCITY = vec3(randf_range(-40.0, 40.0), randf_range(-60.0, 20.0), 0.0);
    COLOR = vec4(1.0, 1.0, 1.0, 0.8);
    SCALE = vec3(0.5);
    CUSTOM = vec4(0.0);
}

void process() {
    CUSTOM.x += DELTA;
    VELOCITY.y += 200.0 * DELTA;
    VELOCITY.x *= pow(0.95, DELTA * 60.0);
    COLOR.a = 0.8 * (1.0 - smoothstep(0.0, lifetime, CUSTOM.x));
    SCALE = vec3(lerp(0.5, 1.5, CUSTOM.x / lifetime));
    
    if (CUSTOM.x >= lifetime) {
        KILL = true;
    }
}

