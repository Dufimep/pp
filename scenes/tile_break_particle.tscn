[gd_scene load_steps=2 format=3 uid="//uid://tile_break_particle"]

[ext_resource type="Script" path="res://scripts/globals.gd" id="1"]

[sub_resource type="Shader" id="Shader_1"]
shader_type = "particles"
render_mode = "additive"

uniform float lifetime : hint_range(0.1, 5.0) = 0.5;

void start() {
    VELOCITY = vec3(randf_range(-80.0, 80.0), randf_range(-120.0, -20.0), 0.0);
    COLOR = vec4(1.0, 1.0, 1.0, 1.0);
    SCALE = vec3(1.0);
    CUSTOM = vec4(0.0); // age
}

void process() {
    CUSTOM.x += DELTA;
    VELOCITY.y += 400.0 * DELTA; // gravity
    VELOCITY.x *= pow(0.98, DELTA * 60.0); // drag
    COLOR.a = 1.0 - smoothstep(0.0, lifetime, CUSTOM.x);
    SCALE = vec3(lerp(1.0, 0.3, CUSTOM.x / lifetime));
    
    if (CUSTOM.x >= lifetime) {
        KILL = true;
    }
}

